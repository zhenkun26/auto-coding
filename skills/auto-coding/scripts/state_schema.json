{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Single cross-session state file for auto-coding. Managed via scripts/manage_state.py (atomic writes). Cleared to {} on handoff; never deleted automatically.",
  "type": "object",
  "properties": {
    "route": { "type": "string", "enum": ["Fast", "Standard", "High-risk"] },
    "phase": { "type": "string", "enum": ["plan", "implement", "verify", "handoff"] },
    "current_task": { "type": "string", "description": "Atomic task in flight, e.g. T008" },
    "current_file": { "type": "string", "description": "File currently being modified" },
    "self_heal_round": { "type": "integer", "minimum": 0, "maximum": 3 },
    "escape_hatches": {
      "type": "array",
      "items": { "type": "string" },
      "description": "[ESCAPE_HATCH] records for the current run"
    },
    "started_at": { "type": "string", "description": "ISO 8601 timestamp of run start" },
    "last_update": { "type": "string", "description": "ISO 8601 timestamp of last state write" },
    "resume_hint": { "type": "string", "description": "Exact next action in one sentence" }
  },
  "required": ["route", "phase", "last_update"]
}
