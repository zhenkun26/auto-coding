{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Optional single-writer task memory. Completion retains the record; recorded evidence requires independent semantic acceptance.",
  "type": "object",
  "properties": {
    "route": {
      "type": "string",
      "enum": [
        "Fast",
        "Standard",
        "High-risk"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "plan",
        "implement",
        "verify",
        "handoff"
      ]
    },
    "current_task": {
      "type": "string",
      "description": "Atomic task in flight, e.g. T008"
    },
    "current_file": {
      "type": "string",
      "description": "File currently being modified"
    },
    "self_heal_round": {
      "type": "integer",
      "minimum": 0
    },
    "escape_hatches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "description": "[ESCAPE_HATCH] records for the current run"
    },
    "started_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of run start"
    },
    "last_update": {
      "type": "string",
      "description": "ISO 8601 timestamp of last state write"
    },
    "resume_hint": {
      "type": "string",
      "description": "Exact next action in one sentence"
    },
    "objective": {
      "type": "string"
    },
    "boundary": {
      "type": "string"
    },
    "plan_ref": {
      "type": "string"
    },
    "completion_summary": {
      "type": "string"
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "completed"
      ]
    }
  },
  "required": [
    "route",
    "phase",
    "last_update"
  ],
  "additionalProperties": false
}
